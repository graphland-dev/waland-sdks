{
  "name": "waland/waland",
  "description": "Official PHP SDK for the Waland WhatsApp API",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Waland",
      "email": "hi@waland.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Waland\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Waland\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
